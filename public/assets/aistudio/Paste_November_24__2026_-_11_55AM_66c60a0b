    function selectDemoStep(index) {
      const buttons = document.querySelectorAll('.demo-step-btn');
      buttons.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.remove('border-slate-100', 'bg-white');
          btn.classList.add('border-sky-300', 'bg-sky-50/90', 'shadow-sm');
        } else {
          btn.classList.remove('border-sky-300', 'bg-sky-50/90', 'shadow-sm');
          btn.classList.add('border-slate-100', 'bg-white');
        }
      });
      document.getElementById('demo-detail').innerHTML = demoDescriptions[index];
    }

