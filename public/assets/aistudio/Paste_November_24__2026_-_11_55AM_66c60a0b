              >
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-xl bg-sky-600 text-white font-bold text-xs flex items-center justify-center">01</span>
                  <div>
                    <div class="text-sm font-bold text-slate-900">STUDY PLAN</div>
                    <div class="text-xs text-slate-500">Lập kế hoạch & quản lý thời gian</div>
